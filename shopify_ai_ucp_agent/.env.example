SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API (search_products, add_to_cart, get_cart)
STOREFRONT_PRIVATE_TOKEN=

# Admin API client-credentials grant (registering the orders/create webhook)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional overrides
# SHOPIFY_STOREFRONT_API_VERSION=2026-07
# SHOPIFY_ADMIN_API_VERSION=2026-07

# Anthropic auth for the Claude Agent SDK itself (or run `claude login` once instead)
ANTHROPIC_API_KEY=

# Chat server (Express) that the test frontend talks to
PORT=3400
