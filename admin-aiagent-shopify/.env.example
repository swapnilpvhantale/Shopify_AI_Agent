SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API client-credentials grant (custom app: Admin API access token
# also works if you set SHOPIFY_ADMIN_ACCESS_TOKEN instead, see below)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: skip the OAuth client-credentials exchange entirely and use a
# static Admin API access token (from a custom app in your store admin,
# Settings > Apps > Develop apps). If set, this takes priority.
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional overrides
# SHOPIFY_ADMIN_API_VERSION=2026-07

# Anthropic auth for the Claude Agent SDK itself (or run `claude login` once instead)
ANTHROPIC_API_KEY=

# Chat server (Express) that the admin console frontend talks to
PORT=3500

# Extra origins allowed to call this API cross-origin (comma separated),
# beyond the built-in VS Code Live Server dev origins.
# EXTRA_ALLOWED_ORIGINS=
